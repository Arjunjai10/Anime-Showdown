# Normalize line endings to LF in the repo, check out as-is on all platforms.
# This silences the CRLF/LF conversion warnings on Windows without forcing
# Windows-style endings into the git history.
* text=auto eol=lf

# Explicitly mark binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
